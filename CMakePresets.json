{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "cacheVariables": {
        "SKSE_SUPPORT_XBYAK": "ON",
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "ON",
        "CMAKE_WARN_DEPRECATED": "OFF"
      }
    },
    {
      "name": "platform-win32",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      },
      "environment": {
        "PROJECT_PLATFORM_FLAGS": "-DWIN32_LEAN_AND_MEAN -DNOMINMAX",
        "PROJECT_PLATFORM": "windows"
      }
    },
    {
      "name": "platform-win32-unicode",
      "hidden": true,
      "inherits": "platform-win32",
      "environment": {
        "PROJECT_TEXT_FLAGS": "-DUNICODE -D_UNICODE"
      }
    },
    {
      "name": "generator-ninja",
      "hidden": true,
      "generator": "Ninja"
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "STRING",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_OVERLAY_PORTS": {
          "type": "STRING",
          "value": "${sourceDir}/cmake/ports/"
        },
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "win64",
      "hidden": true,
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "msvc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/EHsc /MP $penv{CXXFLAGS}"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-msvc-x64",
          "enableMicrosoftCodeAnalysis": true,
          "enableClangTidyCodeAnalysis": true
        }
      }
    },
    {
      "name": "base-config",
      "hidden": true,
      "inherits": [
        "common",
        "vcpkg",
        "platform-win32-unicode",
        "generator-ninja",
        "msvc"
      ],
      "cacheVariables": {
        "ENABLE_SKYRIM_AE": "ON",
        "ENABLE_SKYRIM_SE": "ON",
        "ENABLE_SKYRIM_VR": "OFF",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "config-debug",
      "displayName": "Debug",
      "description": "A debug build.",
      "inherits": "base-config",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "config-release",
      "displayName": "Release (Default)",
      "description": "Configure release build with SSE4.2.",
      "inherits": "base-config",
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "/arch:SSE4.2 /EHsc /Zi /FS /fp:fast /GL /GT /Zc:inline /d2FH4 /Gw /O2 /Ob2 /Oi /Ot /Oy /fp:except- /Gy /Gm- /sdl- /GS /guard:cf- /Qpar",
        "CMAKE_CXX_FLAGS_RELEASE": "/arch:SSE4.2 /O2 /Ob2 /DNDEBUG /GL /GT /Zc:inline /d2FH4 /Gw /Gy /Oi /Ot /Oy /fp:fast /fp:except- /GS /guard:cf- /Qpar",
        "CMAKE_SHARED_LINKER_FLAGS": "/DEBUG:FULL /OPT:REF /OPT:ICF /LTCG /INCREMENTAL:NO",
        "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "/DEBUG:FULL /OPT:REF /OPT:ICF /LTCG /INCREMENTAL:NO"
      }
    },
    {
      "name": "config-release-avx",
      "displayName": "Release (AVX)",
      "description": "Configure release build with AVX.",
      "inherits": "base-config",
      "binaryDir": "${sourceDir}/build/Release-AVX",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "/arch:AVX /EHsc /Zi /FS /fp:fast /GL /GT /Zc:inline /d2FH4 /Gw /O2 /Ob2 /Oi /Ot /Oy /fp:except- /Gy /Gm- /sdl- /GS /guard:cf- /Qpar",
        "CMAKE_CXX_FLAGS_RELEASE": "/arch:AVX /O2 /Ob2 /DNDEBUG /GL /GT /Zc:inline /d2FH4 /Gw /Gy /Oi /Ot /Oy /fp:fast /fp:except- /GS /guard:cf- /Qpar",
        "CMAKE_SHARED_LINKER_FLAGS": "/DEBUG:FULL /OPT:REF /OPT:ICF /LTCG /INCREMENTAL:NO",
        "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "/DEBUG:FULL /OPT:REF /OPT:ICF /LTCG /INCREMENTAL:NO"
      }
    },
    {
      "name": "config-release-avx2",
      "displayName": "Release (AVX)",
      "description": "Configure release build with AVX2.",
      "inherits": "base-config",
      "binaryDir": "${sourceDir}/build/Release-AVX2",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "/arch:AVX2 /EHsc /Zi /FS /fp:fast /GL /GT /Zc:inline /d2FH4 /Gw /O2 /Ob2 /Oi /Ot /Oy /fp:except- /Gy /Gm- /sdl- /GS /guard:cf- /Qpar",
        "CMAKE_CXX_FLAGS_RELEASE": "/arch:AVX2 /O2 /Ob2 /DNDEBUG /GL /GT /Zc:inline /d2FH4 /Gw /Gy /Oi /Ot /Oy /fp:fast /fp:except- /GS /guard:cf- /Qpar",
        "CMAKE_SHARED_LINKER_FLAGS": "/DEBUG:FULL /OPT:REF /OPT:ICF /LTCG /INCREMENTAL:NO",
        "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "/DEBUG:FULL /OPT:REF /OPT:ICF /LTCG /INCREMENTAL:NO"
      }
    },
    {
      "name": "config-release-avx512",
      "displayName": "Release (AVX512)",
      "description": "Configure release build with AVX512.",
      "inherits": "base-config",
      "binaryDir": "${sourceDir}/build/Release-AVX512",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "/arch:AVX512 /EHsc /Zi /FS /fp:fast /GL /GT /Zc:inline /d2FH4 /Gw /O2 /Ob2 /Oi /Ot /Oy /fp:except- /Gy /Gm- /sdl- /GS /guard:cf- /Qpar",
        "CMAKE_CXX_FLAGS_RELEASE": "/arch:AVX512 /O2 /Ob2 /DNDEBUG /GL /GT /Zc:inline /d2FH4 /Gw /Gy /Oi /Ot /Oy /fp:fast /fp:except- /GS /guard:cf- /Qpar",
        "CMAKE_SHARED_LINKER_FLAGS": "/DEBUG:FULL /OPT:REF /OPT:ICF /LTCG /INCREMENTAL:NO",
        "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "/DEBUG:FULL /OPT:REF /OPT:ICF /LTCG /INCREMENTAL:NO"
      }
    },
    {
      "name": "config-debug-profiler",
      "displayName": "Debug (Profiler)",
      "description": "Configure a debug build with GTS_PROFILER_ENABLED.",
      "inherits": "config-debug",
      "binaryDir": "${sourceDir}/build/Debug-Profiler",
      "cacheVariables": {
        "GTS_PROFILER_ENABLED": "ON"
      }
    },
    {
      "name": "config-release-profiler",
      "displayName": "Release (Profiler)",
      "description": "Configure a release build with GTS_PROFILER_ENABLED.",
      "inherits": "config-release",
      "binaryDir": "${sourceDir}/build/Release-Profiler",
      "cacheVariables": {
        "GTS_PROFILER_ENABLED": "ON"
      }
    },
    {
      "name": "config-release-disabled",
      "displayName": "Release (Plugin Disabled)",
      "description": "Configure a release build with GTS_DISABLE_PLUGIN.",
      "inherits": "config-release",
      "binaryDir": "${sourceDir}/build/Release-Disabled",
      "cacheVariables": {
        "GTS_DISABLE_PLUGIN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "displayName": "Build AE/SE (Debug)",
      "configurePreset": "config-debug",
      "description": "Compile a debug build."
    },
    {
      "name": "build-release",
      "displayName": "Build AE/SE (Release)",
      "configurePreset": "config-release",
      "description": "Compile an optimized release build (SSE4.2)."
    },
    {
      "name": "build-release-avx",
      "displayName": "Build AE/SE (Release AVX)",
      "configurePreset": "config-release-avx",
      "description": "Compile an optimized release build (AVX)."
    },
    {
      "name": "build-release-avx2",
      "displayName": "Build AE/SE (Release AVX2)",
      "configurePreset": "config-release-avx2",
      "description": "Compile an optimized release build (AVX2)."
    },
    {
      "name": "build-release-avx512",
      "displayName": "Build AE/SE (Release AVX512)",
      "configurePreset": "config-release-avx512",
      "description": "Compile an optimized release build (AVX512)."
    },
    {
      "name": "build-debug-profiler",
      "displayName": "Build AE/SE (Debug Profiler)",
      "configurePreset": "config-debug-profiler",
      "description": "Compile a debug build with the performance profiler enabled."
    },
    {
      "name": "build-release-profiler",
      "displayName": "Build AE/SE (Release Profiler)",
      "configurePreset": "config-release-profiler",
      "description": "Compile an optimized release build with the performance profiler enabled."
    },
    {
      "name": "build-release-disabled",
      "displayName": "Build AE/SE (Release Plugin Disabled)",
      "configurePreset": "config-release-disabled",
      "description": "Compile an optimized release build with the plugin disabled, serialization only."
    }
  ]
}
